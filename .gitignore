# SOLARA BAY — files git ignores, and why.
# out/ — make.fun build output (dossier + bundle), regenerated by main.ts.
# node_modules/ — Playwright + tooling dependencies, installed with npm.
# dist/ — any bundled build output produced locally.
# coverage/ — test coverage reports.
# *.log — tool, server, and playtest logs.
# .DS_Store — macOS Finder metadata, not part of the game.
# screenshots/playtest-end.jpg — a local playtest capture, not a dossier shot; keep it out of commits.
out/
node_modules/
dist/
coverage/
*.log
.DS_Store
screenshots/playtest-end.jpg
